{
  "name": "ilas",
  "version": "0.1.0",
  "description": "Integrity Layer for Agentic Systems",
  "main": "dist/index.js",
  "scripts": {
    "test": "find src packages -name '*.test.ts' -not -path '*/node_modules/*' -print0 | sort -z | xargs -0 -n1 ts-node",
    "test:list": "find src packages -name '*.test.ts' -not -path '*/node_modules/*' | sort",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p packages/clerk && tsc -p packages/witness"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
